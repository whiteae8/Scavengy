@model Scavengy.Models.CreateHuntViewModel

<form id="createHuntForm"
      hx-post="@Url.Action("CreateHunt", "Home")"
      hx-target="#hunts-table-body"
      hx-swap="afterbegin"
      hx-validate="true">
    <div class="modal-body">
        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }
        <div class="mb-3">
            <label for="Title" class="form-label">Title</label>
            <input id="Title" name="Title" value="@Model.Form.Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label for="city-picker" class="form-label">Hunt Location</label>

            <gmpx-place-picker id="city-picker"
                               type="(cities)"
                               placeholder="Search a city…"
                               class="form-control p-0 border-0"
                               style="display:block; width:100%;"></gmpx-place-picker>

            <input type="hidden" id="HuntLocation" name="HuntLocation"
                   value="@Model.Form.HuntLocation" />
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

<script>
    (function () {
        const form = document.getElementById('createHuntForm');
        const picker = document.getElementById('city-picker');
        const hidden = document.getElementById('HuntLocation');
        const errorAlert = form.querySelector('.alert-danger');

        picker.addEventListener('gmpx-placechange', () => {
            const place = picker.value;
            hidden.value = place?.formattedAddress ?? place?.displayName ?? '';
            errorAlert?.remove();
        });

        form.addEventListener('htmx:beforeRequest', () => errorAlert?.remove());
    })();
</script>
