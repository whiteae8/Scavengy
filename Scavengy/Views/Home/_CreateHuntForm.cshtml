@model Scavengy.Models.CreateHuntViewModel

<form id="createHuntForm"
      hx-post="@Url.Action("CreateHunt", "Home")"
      hx-target="#hunts-table-body"
      hx-swap="afterbegin"
      hx-validate="true">
    <div class="modal-body">
        @if (Model.Error != null)
        {
            <div class="alert alert-danger">@Model.Error</div>
        }
        <div class="mb-3">
            <label for="Title" class="form-label">Title</label>
            <input id="Title" name="Title" value="@Model.Form.Title" class="form-control" required />
        </div>
        <div class="mb-3">
            <label for="HuntLocation" class="form-label">Hunt Location</label>
            <select id="HuntLocation" name="HuntLocation" class="form-select" required>
                @if (!string.IsNullOrEmpty(Model.Form.HuntLocation))
                {
                    <option value="@Model.Form.HuntLocation" selected>@Model.Form.HuntLocation</option>
                }
            </select>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Create</button>
    </div>
</form>

<script>
    function initHuntLocationTomSelect() {
        const select = document.getElementById('HuntLocation');
        if (!select || select.tomselect) return;

        new TomSelect(select, {
            create: false,
            load: function (query, callback) {
                if (!query.length) return callback();
                fetch(`/Home/LocationSuggestions?query=${encodeURIComponent(query)}`)
                    .then(r => r.json())
                    .then(data => callback(data))
                    .catch(() => callback());
            }
        });
    }

    initHuntLocationTomSelect();
</script>
