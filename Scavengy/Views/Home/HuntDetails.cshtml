@model Scavengy.ServiceModel.Hunt
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Title;
}

<div class="mb-4">
    <a href="@Url.Action("Index", "Home")" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left"></i> Back to hunts
    </a>
</div>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="mb-1">@Model.Title</h1>
        <p class="text-muted mb-0">@Model.HuntLocation</p>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th style="width: 3rem">#</th>
                <th>Clue</th>
                <th>Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var clue in Model.Clues.OrderBy(c => c.ClueIndex))
            {
                <tr>
                    <td class="text-muted">@clue.ClueIndex</td>
                    <td>@clue.ClueText</td>
                    <td>@clue.LocationName</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Clues.Any())
    {
        <p class="text-muted text-center mt-3">No clues yet.</p>
    }
</div>
