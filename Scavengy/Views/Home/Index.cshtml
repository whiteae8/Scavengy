@model List<Scavengy.ServiceModel.Hunt>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Home";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Scavengy</h1>
    <button class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#createHuntModal"
            hx-get="@Url.Action("CreateHuntForm", "Home")"
            hx-target="#createHuntModalContent">
        Create Hunt
    </button>
</div>

<div class="modal fade" id="createHuntModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Hunt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="createHuntModalContent"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="renameHuntModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rename Hunt</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div id="renameHuntModalContent"></div>
        </div>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Location</th>
            <th>Created</th>
            <th>Clues</th>
            <th></th>
        </tr>
        </thead>
        <tbody id="hunts-table-body">
        @foreach (var hunt in Model)
        {
            @await Html.PartialAsync("_HuntRow", hunt)
        }
        </tbody>
    </table>

    <p id="no-hunts" class="text-muted text-center mt-3 @(Model.Any() ? "d-none" : "")">No hunts yet — create one to get started.</p>
</div>

@section scripts {
    <script>
    document.body.addEventListener('huntCreated', function () {
        bootstrap.Modal.getInstance(document.getElementById('createHuntModal'))?.hide();
        document.getElementById('no-hunts')?.classList.add('d-none');
    });
    document.body.addEventListener('cluesFailed', function () {
        showToast('Hunt created, but clue generation failed.', 'warning');
    });
    document.body.addEventListener('huntRenamed', function () {
        bootstrap.Modal.getInstance(document.getElementById('renameHuntModal'))?.hide();
    });
    document.body.addEventListener('huntDeleted', function () {
        if (!document.querySelector('#hunts-table-body tr')) {
            document.getElementById('no-hunts')?.classList.remove('d-none');
        }
    });
    </script>
}