@model Scavengy.ServiceModel.Hunt
<tr id="hunt-row-@Model.Id">
    <td><a href="@Url.Action("HuntDetails", "Home", new { id = Model.Id })" class="text-decoration-none">@Model.Title</a></td>
    <td>@Model.HuntLocation</td>
    <td>@Model.CreatedDate.ToString("MMM d, yyyy")</td>
    <td class="text-end">
        <div class="dropdown">
            <button class="btn btn-sm p-0 border-0 bg-transparent" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <button class="dropdown-item" type="button"
                            hx-get="@Url.Action("RenameHuntForm", "Home", new { id = Model.Id })"
                            hx-target="#renameHuntModalContent"
                            data-bs-toggle="modal"
                            data-bs-target="#renameHuntModal">
                        Rename
                    </button>
                </li>
                <li>
                    <button class="dropdown-item text-danger" type="button"
                            hx-delete="@Url.Action("DeleteHunt", "Home", new { id = Model.Id })"
                            hx-target="#hunt-row-@Model.Id"
                            hx-swap="delete"
                            hx-confirm="Delete this hunt?">
                        Delete
                    </button>
                </li>
            </ul>
        </div>
    </td>
</tr>
