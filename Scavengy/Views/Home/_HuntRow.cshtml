@model Scavengy.Models.HuntRowViewModel
<tr id="hunt-row-@Model.Hunt.Id" @Html.Raw(Model.Oob != null ? $"hx-swap-oob=\"{Model.Oob}\"" : "")>
    <td>@Model.Hunt.Title</td>
    <td>@Model.Hunt.HuntLocation</td>
    <td>@Model.Hunt.CreatedDate.ToString("MMM d, yyyy")</td>
    <td class="text-end">
        <div class="dropdown">
            <button class="btn btn-sm p-0 border-0 bg-transparent" type="button"
                    data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li>
                    <button class="dropdown-item" type="button"
                            hx-get="@Url.Action("RenameHuntForm", "Home", new { id = Model.Hunt.Id })"
                            hx-target="#renameHuntModalContent"
                            data-bs-toggle="modal"
                            data-bs-target="#renameHuntModal">
                        Rename
                    </button>
                </li>
            </ul>
        </div>
    </td>
</tr>
